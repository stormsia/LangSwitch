<?xml version="1.0" encoding="UTF-8"?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="LangSwitch"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="stormsia"
    UpgradeCode="AA4AA6AB-DBCC-4AF8-9DF7-4b4ae7a5f5ab"> <Package
      Description="KDE Plasma-style keyboard layout switcher OSD for Windows"
      Comments="Displays a smooth OSD indicator when switching keyboard layouts"
      Manufacturer="stormsia"
      InstallerVersion="450"
      Compressed="yes"
      InstallScope="perMachine"
      Languages="1033" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of LangSwitch is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Start LangSwitch automatically when Windows starts" />

    <Property Id="WixShellExecTarget" Value="[#langswitch.exe]" />
    <CustomAction Id="LaunchApp"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI>
      <UIRef Id="WixUI_InstallDir" />

      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApp">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.PlatformProgramFilesFolder)">
        <Directory Id="APPLICATIONFOLDER" Name="LangSwitch" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="LangSwitch" />
      </Directory>
    </Directory>

    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="MainExecutable"
                 Guid="E356960B-1CC9-4E03-B45B-D6BBFE5FC985">
        <File Id="langswitch.exe"
              Source="$(var.CargoTargetBinDir)\langswitch.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="AutostartComponent"
                 Guid="A415A299-9613-417D-90C3-16403D727037">
        <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="LangSwitch"
          Type="string"
          Value="&quot;[APPLICATIONFOLDER]langswitch.exe&quot;"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut"
                 Guid="9CC0B235-4964-4892-BF9C-D8E5052666DE">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="LangSwitch"
                  Description="KDE-style keyboard layout switcher OSD"
                  Target="[APPLICATIONFOLDER]langswitch.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="CleanupStartMenu"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\stormsia\LangSwitch"
          Name="StartMenuInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature"
             Title="LangSwitch"
             Description="Installs LangSwitch keyboard layout switcher."
             Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Feature Id="AutostartFeature"
             Title="Start with Windows"
             Description="Automatically start LangSwitch when you log in."
             Level="1">
      <ComponentRef Id="AutostartComponent" />
    </Feature>

  </Product>
</Wix>