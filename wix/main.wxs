<?xml version="1.0" encoding="UTF-8"?>
<!--
  LangSwitch WiX Installer
  Per-Machine install → C:\Program Files\LangSwitch\
  Autostart via HKCU Run (enabled by default, user can uncheck)
  Language: English (1033)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="LangSwitch"
    Language="1033"
    Version="0.1.0"
    Manufacturer="stormsia"
    UpgradeCode="3E6EABA7-090A-45B4-9882-BCA22E424735">

    <Package
      Description="KDE Plasma-style keyboard layout switcher OSD for Windows"
      Comments="Displays a smooth OSD indicator when switching keyboard layouts"
      Manufacturer="stormsia"
      InstallerVersion="405"
      Platform="x64"
      Compressed="yes"
      InstallScope="perMachine"
      Languages="1033" />

    <!-- Always upgrade, never allow two versions side-by-side -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of LangSwitch is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ═══════════════════════════════════════════════════
         PROPERTIES
    ═══════════════════════════════════════════════════ -->

    <!-- WixUI: set default install dir to Program Files\LangSwitch -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Autostart checkbox: checked (1) by default -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Start LangSwitch automatically when Windows starts" />

    <!-- Launch app after install checkbox text (optional, same dialog) -->
    <Property Id="WixShellExecTarget" Value="[#langswitch.exe]" />
    <CustomAction Id="LaunchApp"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- ═══════════════════════════════════════════════════
         UI
    ═══════════════════════════════════════════════════ -->
    <UI>
      <UIRef Id="WixUI_InstallDir" />

      <!-- Wire the optional exit checkbox to launch the app -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApp">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>


    <!-- ═══════════════════════════════════════════════════
         DIRECTORY STRUCTURE
    ═══════════════════════════════════════════════════ -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="LangSwitch" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="LangSwitch" />
      </Directory>
    </Directory>

    <!-- ═══════════════════════════════════════════════════
         COMPONENTS
    ═══════════════════════════════════════════════════ -->

    <!-- Main executable -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable"
                 Guid="E356960B-1CC9-4E03-B45B-D6BBFE5FC985"
                 Win64="yes">
        <File Id="langswitch.exe"
              Source="target\x86_64-pc-windows-msvc\release\langswitch.exe"
              KeyPath="yes" />
      </Component>

      <!-- Autostart registry entry (HKCU — no UAC needed at runtime) -->
      <Component Id="AutostartComponent"
                 Guid="A415A299-9613-417D-90C3-16403D727037"
                 Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="LangSwitch"
          Type="string"
          Value="[INSTALLFOLDER]langswitch.exe"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut"
                 Guid="9CC0B235-4964-4892-BF9C-D8E5052666DE"
                 Win64="yes">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="LangSwitch"
                  Description="KDE-style keyboard layout switcher OSD"
                  Target="[INSTALLFOLDER]langswitch.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupStartMenu"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\stormsia\LangSwitch"
          Name="StartMenuInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ═══════════════════════════════════════════════════
         FEATURES
    ═══════════════════════════════════════════════════ -->
    <Feature Id="MainFeature"
             Title="LangSwitch"
             Description="Installs LangSwitch keyboard layout switcher."
             Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Autostart as a separate feature so MSI can remove the key on uninstall -->
    <Feature Id="AutostartFeature"
             Title="Start with Windows"
             Description="Automatically start LangSwitch when you log in."
             Level="1">
      <ComponentRef Id="AutostartComponent" />
    </Feature>

  </Product>
</Wix>
